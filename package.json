{
  "name": "geohub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit.test.ts",
    "data": "python scripts/data/build.py",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests package.json tsconfig.json playwright.config.ts",
    "test:e2e:production": "TEST_PRODUCTION=1 playwright test"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "maplibre-gl": "5.12.0",
    "pmtiles": "4.3.0",
    "proj4": "2.19.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.8"
  }
}
